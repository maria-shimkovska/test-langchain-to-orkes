                }
              },
              "context": "${decide_human_or_auto_ref.output.result.human_context}",
              "decision": ""
            },
            "type": "HUMAN",
            "decisionCases": {},
            "defaultCase": [],
            "forkTasks": [],
            "startDelay": 0,
            "joinOn": [],
