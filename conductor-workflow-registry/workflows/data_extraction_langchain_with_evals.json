    {
      "name": "decide_human_or_auto",
      "taskReferenceName": "decide_human_or_auto_ref",
      "inputParameters": {
        "expression": "function parseOrKeep(x) {\n  // If it's already an object, keep it.\n  if (x !== null && typeof x === \"object\") return x;\n\n  // If it's a string, try JSON.parse; else return null.\n  try {\n    return JSON.parse(String(x));\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction safeString(x) {\n  if (x === null || x === undefined) return \"\";\n  if (typeof x === \"object\") return JSON.stringify(x, null, 2);\n  return String(x);\n}\n\nvar grounding = parseOrKeep($.grounding_response);\nvar routing = parseOrKeep($.routing_response);\nvar quality = parseOrKeep($.quality_response);\n\nvar out = {};\n\n// Fail-safe: if anything is missing/unparseable, send to human\nif (grounding == null || routing == null || quality == null) {\n  out = {\n    route: \"HUMAN\",\n    reason: \"missing_or_unparseable_eval_response\",\n    details: {\n      grounding_ok: grounding != null,\n      routing_ok: routing != null,\n      quality_ok: quality != null\n    },\n    // helpful for humans / logs\n    evals: {\n      grounding: grounding,\n      routing: routing,\n      quality: quality\n    }\n  };\n} else {\n  var failed = [];\n\n  if (grounding.passed === false) failed.push(\"grounding\");\n  if (routing.passed === false) failed.push(\"routing\");\n  if (quality.passed === false) failed.push(\"quality\");\n\n  if (failed.length > 0) {\n    out = {\n      route: \"HUMAN\",\n      reason: \"one_or_more_evals_failed\",\n      failed_evals: failed,\n      evals: {\n        grounding: grounding,\n        routing: routing,\n        quality: quality\n      }\n    };\n  } else {\n    out = {\n      route: \"AUTO\",\n      reason: \"all_evals_passed\",\n      evals: {\n        grounding: grounding,\n        routing: routing,\n        quality: quality\n      }\n    };\n  }\n}\n\n// OPTIONAL: build a guaranteed string for the human form\nout.human_context =\n  \"ORIGINAL MESSAGE\\n----------------\\n\" + safeString($.original_message) + \"\\n\\n\" +\n  \"EXTRACTED TICKET\\n----------------\\n\" + safeString($.extraction_output) + \"\\n\\n\" +\n  \"EVAL RESULTS\\n-----------\\n\" +\n  \"Grounding:\\n\" + safeString(grounding) + \"\\n\\n\" +\n  \"Routing:\\n\" + safeString(routing) + \"\\n\\n\" +\n  \"Quality:\\n\" + safeString(quality) + \"\\n\";\n\n// IMPORTANT: INLINE expects the last expression to be the result\nout;\n",
        "evaluatorType": "graaljs",
        "quality_response": "${eval_aggregator_ref.output.quality_eval_agent_ref.response}",
        "grounding_response": "${eval_aggregator_ref.output.grounding_eval_agent_ref.response}",
        "routing_response": "${eval_aggregator_ref.output.routing_eval_agent_ref.response}",
        "original_message": "${workflow.input.query}",
        "extraction_output": "${extract_agent_ref.output.response}"
      },
      "type": "INLINE",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false
    },
